<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Encrypted with a device-bound Keystore key: a restored copy can never be decrypted. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="voicelock_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="voicelock_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
