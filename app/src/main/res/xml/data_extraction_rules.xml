<?xml version="1.0" encoding="utf-8"?>
<!-- Voice templates are biometric data: never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="voice_profile.json" />
        <exclude domain="file" path="voice_fingerprints.json" />
        <exclude domain="sharedpref" path="backup_pin.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="voice_profile.json" />
        <exclude domain="file" path="voice_fingerprints.json" />
        <exclude domain="sharedpref" path="backup_pin.xml" />
    </device-transfer>
</data-extraction-rules>
