<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_24dp"
    android:paddingTop="@dimen/_48dp"
    android:paddingBottom="@dimen/_32dp">

    <TextView
        android:id="@+id/tvEnrollTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voice_enroll_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEnrollSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:text="@string/voice_enroll_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEnrollTitle" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressSamples"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_32dp"
        android:max="3"
        app:indicatorColor="@color/primary_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEnrollSubtitle"
        app:trackColor="@color/divider_line"
        app:trackCornerRadius="@dimen/_4dp"
        app:trackThickness="@dimen/_8dp" />

    <TextView
        android:id="@+id/tvSampleCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressSamples" />

    <ImageView
        android:id="@+id/btnRecord"
        android:layout_width="@dimen/_120dp"
        android:layout_height="@dimen/_120dp"
        android:background="@drawable/bg_circle_icon"
        android:contentDescription="@string/voice_enroll_record"
        android:padding="@dimen/_36dp"
        android:src="@drawable/ic_mic"
        app:layout_constraintBottom_toTopOf="@id/tvEnrollStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSampleCount"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/primary_blue" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressRecording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary_blue"
        app:indicatorSize="@dimen/_136dp"
        app:layout_constraintBottom_toBottomOf="@id/btnRecord"
        app:layout_constraintEnd_toEndOf="@id/btnRecord"
        app:layout_constraintStart_toStartOf="@id/btnRecord"
        app:layout_constraintTop_toTopOf="@id/btnRecord" />

    <TextView
        android:id="@+id/tvEnrollStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sp"
        app:layout_constraintBottom_toTopOf="@id/tvHeardTexts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRecord" />

    <TextView
        android:id="@+id/tvHeardTexts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_4dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tvEnrollError"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEnrollStatus" />

    <TextView
        android:id="@+id/tvEnrollError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:textColor="@color/error_red"
        android:textSize="@dimen/_13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnEnrollAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeardTexts" />

    <TextView
        android:id="@+id/btnEnrollAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52dp"
        android:background="@drawable/bg_blue_button"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnEnrollRestart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnEnrollRestart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:padding="@dimen/_12dp"
        android:text="@string/voice_enroll_restart"
        android:textColor="@color/primary_blue"
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
