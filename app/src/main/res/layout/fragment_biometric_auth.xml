<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:paddingHorizontal="@dimen/_24dp"
    android:paddingTop="@dimen/_48dp"
    android:paddingBottom="@dimen/_24dp">

    <TextView
        android:id="@+id/tvBiometricAuthTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/biometric_auth_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBiometricAuthSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:text="@string/biometric_auth_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBiometricAuthTitle" />

    <LinearLayout
        android:id="@+id/layoutBiometricIcons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_48dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBiometricAuthSubtitle">

        <ImageView
            android:layout_width="@dimen/_96dp"
            android:layout_height="@dimen/_96dp"
            android:background="@drawable/bg_circle_icon"
            android:importantForAccessibility="no"
            android:padding="@dimen/_26dp"
            android:src="@drawable/ic_fingerprint" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvBiometricAuthStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_32dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBiometricIcons" />

    <TextView
        android:id="@+id/tvBiometricAuthError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:textColor="@color/error_red"
        android:textSize="@dimen/_13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBiometricAuthStatus" />

    <TextView
        android:id="@+id/btnBiometricAuthAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52dp"
        android:background="@drawable/bg_blue_button"
        android:gravity="center"
        android:text="@string/biometric_auth_action"
        android:textColor="@color/white"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
