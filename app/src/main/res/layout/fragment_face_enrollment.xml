<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_24dp"
    android:paddingTop="@dimen/_48dp"
    android:paddingBottom="@dimen/_32dp">

    <TextView
        android:id="@+id/tvFaceEnrollTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/face_enroll_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFaceEnrollSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFaceEnrollTitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFacePreview"
        android:layout_width="@dimen/_240dp"
        android:layout_height="@dimen/_240dp"
        android:layout_marginTop="@dimen/_32dp"
        app:cardBackgroundColor="@color/bg_card_dark"
        app:cardCornerRadius="@dimen/_120dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFaceEnrollSubtitle"
        app:strokeColor="@color/primary_blue"
        app:strokeWidth="@dimen/_3dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewFace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressFaceScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary_blue"
        app:indicatorSize="@dimen/_256dp"
        app:layout_constraintBottom_toBottomOf="@id/cardFacePreview"
        app:layout_constraintEnd_toEndOf="@id/cardFacePreview"
        app:layout_constraintStart_toStartOf="@id/cardFacePreview"
        app:layout_constraintTop_toTopOf="@id/cardFacePreview"
        app:trackThickness="@dimen/_3dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressFaceSamples"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_32dp"
        android:max="3"
        app:indicatorColor="@color/primary_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardFacePreview"
        app:trackColor="@color/divider_line"
        app:trackCornerRadius="@dimen/_4dp"
        app:trackThickness="@dimen/_8dp" />

    <TextView
        android:id="@+id/tvFaceSampleCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressFaceSamples" />

    <TextView
        android:id="@+id/tvFaceEnrollStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFaceSampleCount" />

    <TextView
        android:id="@+id/tvFaceEnrollMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_13sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFaceEnrollStatus" />

    <TextView
        android:id="@+id/btnFaceEnrollAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52dp"
        android:background="@drawable/bg_blue_button"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnFaceEnrollRestart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnFaceEnrollRestart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:padding="@dimen/_12dp"
        android:text="@string/face_enroll_restart"
        android:textColor="@color/primary_blue"
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
