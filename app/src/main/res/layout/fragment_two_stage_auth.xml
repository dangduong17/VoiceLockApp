<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_24dp"
    android:paddingTop="@dimen/_48dp"
    android:paddingBottom="@dimen/_32dp">

    <TextView
        android:id="@+id/tvAuthTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voice_auth_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20dp"
        app:checkedButton="@id/btnModeUnlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAuthTitle"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeUnlock"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_auth_mode_unlock" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeLock"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_auth_mode_lock" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ImageView
        android:id="@+id/ivAuthMic"
        android:layout_width="@dimen/_120dp"
        android:layout_height="@dimen/_120dp"
        android:background="@drawable/bg_circle_icon"
        android:importantForAccessibility="no"
        android:padding="@dimen/_36dp"
        android:src="@drawable/ic_mic"
        app:layout_constraintBottom_toTopOf="@id/tvAuthStage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggleMode"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/primary_blue" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressAuth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary_blue"
        app:indicatorSize="@dimen/_136dp"
        app:layout_constraintBottom_toBottomOf="@id/ivAuthMic"
        app:layout_constraintEnd_toEndOf="@id/ivAuthMic"
        app:layout_constraintStart_toStartOf="@id/ivAuthMic"
        app:layout_constraintTop_toTopOf="@id/ivAuthMic" />

    <TextView
        android:id="@+id/tvAuthStage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvRecognizedText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivAuthMic" />

    <TextView
        android:id="@+id/tvRecognizedText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tvScores"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAuthStage" />

    <TextView
        android:id="@+id/tvScores"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/_12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnAuthAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRecognizedText" />

    <TextView
        android:id="@+id/tvVolumeKeyHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12dp"
        android:gravity="center"
        android:text="@string/voice_volume_key_hint"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnAuthAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnAuthAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52dp"
        android:background="@drawable/bg_blue_button"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
