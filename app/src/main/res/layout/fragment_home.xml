<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/_16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16dp"
            android:paddingTop="@dimen/_12dp">

            <!-- Top Header Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:importantForAccessibility="no"
                    android:id="@+id/ivLogo"
                    android:layout_width="@dimen/_28dp"
                    android:layout_height="@dimen/_28dp"
                    android:src="@drawable/ic_waveform"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/ivLogo"
                    app:layout_constraintStart_toEndOf="@id/ivLogo"
                    app:layout_constraintTop_toTopOf="@id/ivLogo" />

                <ImageView
                    android:importantForAccessibility="no"
                    android:id="@+id/ivHeaderShield"
                    android:layout_width="@dimen/_24dp"
                    android:layout_height="@dimen/_24dp"
                    android:src="@drawable/ic_shield"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Greeting Text -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20dp"
                android:text="@string/greeting_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:text="@string/greeting_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_14sp" />

            <!-- Dark Status Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardDarkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20dp"
                android:background="@drawable/bg_dark_card"
                android:padding="@dimen/_20dp">

                <ImageView
                    android:importantForAccessibility="no"
                    android:id="@+id/ivBadgeShield"
                    android:layout_width="@dimen/_18dp"
                    android:layout_height="@dimen/_18dp"
                    android:src="@drawable/ic_shield_check"
                    app:layout_constraintBottom_toBottomOf="@id/tvBadgeText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvBadgeText" />

                <TextView
                    android:id="@+id/tvBadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6dp"
                    android:text="@string/protection_status_enabled"
                    android:textColor="@color/cyan_badge"
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/ivBadgeShield"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvVoiceReadyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12dp"
                    android:text="@string/voice_ready"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBadgeText" />

                <TextView
                    android:id="@+id/tvVoiceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6dp"
                    android:text="@string/voice_info"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/_13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVoiceReadyTitle" />

                <!-- Lock Now Button -->
                <LinearLayout
                    android:id="@+id/btnLockNow"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_marginTop="@dimen/_20dp"
                    android:background="@drawable/bg_blue_button"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/tvVoiceInfo">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:layout_width="@dimen/_18dp"
                        android:layout_height="@dimen/_18dp"
                        android:layout_marginEnd="@dimen/_8dp"
                        android:src="@drawable/ic_lock" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lock_now"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Voice Options Card (White Card) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="@dimen/_16dp">

                <!-- Row 1: Unlock by Voice -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowVoiceUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivMicCircle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="@dimen/_8dp"
                        android:src="@drawable/ic_mic"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvVoiceUnlockTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginEnd="@dimen/_12dp"
                        android:text="@string/unlock_by_voice"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/switchVoiceUnlock"
                        app:layout_constraintStart_toEndOf="@id/ivMicCircle"
                        app:layout_constraintTop_toTopOf="@id/ivMicCircle" />

                    <TextView
                        android:id="@+id/tvVoiceUnlockSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginEnd="@dimen/_12dp"
                        android:layout_marginTop="@dimen/_2dp"
                        android:text="@string/unlock_by_voice_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_12sp"
                        app:layout_constraintEnd_toStartOf="@id/switchVoiceUnlock"
                        app:layout_constraintStart_toEndOf="@id/ivMicCircle"
                        app:layout_constraintTop_toBottomOf="@id/tvVoiceUnlockTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVoiceUnlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1dp"
                    android:layout_marginVertical="@dimen/_12dp"
                    android:background="@color/divider_line" />

                <!-- Row 2: Lock by Voice -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowVoiceLock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivWaveCircle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="@dimen/_8dp"
                        android:src="@drawable/ic_sound_wave"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvVoiceLockTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginEnd="@dimen/_12dp"
                        android:text="@string/lock_by_voice"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/switchVoiceLock"
                        app:layout_constraintStart_toEndOf="@id/ivWaveCircle"
                        app:layout_constraintTop_toTopOf="@id/ivWaveCircle" />

                    <TextView
                        android:id="@+id/tvVoiceLockSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginEnd="@dimen/_12dp"
                        android:layout_marginTop="@dimen/_2dp"
                        android:text="@string/lock_by_voice_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_12sp"
                        app:layout_constraintEnd_toStartOf="@id/switchVoiceLock"
                        app:layout_constraintStart_toEndOf="@id/ivWaveCircle"
                        app:layout_constraintTop_toBottomOf="@id/tvVoiceLockTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVoiceLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- Security & Recovery Header -->
            <TextView
                android:id="@+id/tvSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20dp"
                android:text="@string/security_recovery_header"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12sp"
                android:textStyle="bold" />

            <!-- Security Methods Card (White Card) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="@dimen/_16dp">

                <!-- Item 1: PIN -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivKeyCircle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="@dimen/_8dp"
                        android:src="@drawable/ic_key"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPinTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:text="@string/pin_code"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/ivPinArrow"
                        app:layout_constraintStart_toEndOf="@id/ivKeyCircle"
                        app:layout_constraintTop_toTopOf="@id/ivKeyCircle" />

                    <TextView
                        android:id="@+id/tvPinSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginTop="@dimen/_2dp"
                        android:text="@string/pin_code_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_12sp"
                        app:layout_constraintEnd_toStartOf="@id/ivPinArrow"
                        app:layout_constraintStart_toEndOf="@id/ivKeyCircle"
                        app:layout_constraintTop_toBottomOf="@id/tvPinTitle" />

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivPinArrow"
                        android:layout_width="@dimen/_20dp"
                        android:layout_height="@dimen/_20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1dp"
                    android:layout_marginVertical="@dimen/_12dp"
                    android:background="@color/divider_line" />

                <!-- Item 2: Pattern Lock -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnPattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivPatternCircle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="@dimen/_8dp"
                        android:src="@drawable/ic_pattern"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPatternTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:text="@string/pattern_lock"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivPatternCircle"
                        app:layout_constraintEnd_toStartOf="@id/tvPatternAction"
                        app:layout_constraintStart_toEndOf="@id/ivPatternCircle"
                        app:layout_constraintTop_toTopOf="@id/ivPatternCircle" />

                    <TextView
                        android:id="@+id/tvPatternAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/_13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1dp"
                    android:layout_marginVertical="@dimen/_12dp"
                    android:background="@color/divider_line" />

                <!-- Item 3: Fingerprint -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivFingerprintCircle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="@dimen/_8dp"
                        android:src="@drawable/ic_fingerprint"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvFingerprintTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:text="@string/fingerprint"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivFingerprintCircle"
                        app:layout_constraintEnd_toStartOf="@id/tvFingerprintAction"
                        app:layout_constraintStart_toEndOf="@id/ivFingerprintCircle"
                        app:layout_constraintTop_toTopOf="@id/ivFingerprintCircle" />

                    <TextView
                        android:id="@+id/tvFingerprintAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/not_enabled"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/_13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1dp"
                    android:layout_marginVertical="@dimen/_12dp"
                    android:background="@color/divider_line" />

                <!-- Item 4: Face -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnFace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivFaceCircle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="@dimen/_8dp"
                        android:src="@drawable/ic_face"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvFaceTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:text="@string/face_unlock_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivFaceCircle"
                        app:layout_constraintEnd_toStartOf="@id/tvFaceAction"
                        app:layout_constraintStart_toEndOf="@id/ivFaceCircle"
                        app:layout_constraintTop_toTopOf="@id/ivFaceCircle" />

                    <TextView
                        android:id="@+id/tvFaceAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup"
                        android:textColor="@color/primary_blue"
                        android:textSize="@dimen/_13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1dp"
                    android:layout_marginVertical="@dimen/_12dp"
                    android:background="@color/divider_line" />

                <!-- Item 5: Security Questions -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivQuestionCircle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="@dimen/_8dp"
                        android:src="@drawable/ic_question"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvQuestionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:text="@string/security_question"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivQuestionCircle"
                        app:layout_constraintEnd_toStartOf="@id/ivQuestionArrow"
                        app:layout_constraintStart_toEndOf="@id/ivQuestionCircle"
                        app:layout_constraintTop_toTopOf="@id/ivQuestionCircle" />

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivQuestionArrow"
                        android:layout_width="@dimen/_20dp"
                        android:layout_height="@dimen/_20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1dp"
                    android:layout_marginVertical="@dimen/_12dp"
                    android:background="@color/divider_line" />

                <!-- Item 6: App Lock -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnAppLock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivAppLockCircle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="@dimen/_8dp"
                        android:src="@drawable/ic_apps"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAppLockTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12dp"
                        android:text="@string/app_lock_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivAppLockCircle"
                        app:layout_constraintEnd_toStartOf="@id/ivAppLockArrow"
                        app:layout_constraintStart_toEndOf="@id/ivAppLockCircle"
                        app:layout_constraintTop_toTopOf="@id/ivAppLockCircle" />

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/ivAppLockArrow"
                        android:layout_width="@dimen/_20dp"
                        android:layout_height="@dimen/_20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_64dp"
        android:background="@color/white"
        android:elevation="@dimen/_8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Protection (Active) -->
        <LinearLayout
            android:id="@+id/tabProtection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:importantForAccessibility="no"
                android:layout_width="@dimen/_22dp"
                android:layout_height="@dimen/_22dp"
                android:src="@drawable/ic_shield_check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:text="@string/nav_protection"
                android:textColor="@color/primary_blue"
                android:textSize="@dimen/_11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Voice (Inactive) -->
        <LinearLayout
            android:id="@+id/tabVoice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:importantForAccessibility="no"
                android:layout_width="@dimen/_22dp"
                android:layout_height="@dimen/_22dp"
                android:src="@drawable/ic_sound_wave"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:text="@string/nav_voice"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11sp" />
        </LinearLayout>

        <!-- Tab 3: Settings (Inactive) -->
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:importantForAccessibility="no"
                android:layout_width="@dimen/_22dp"
                android:layout_height="@dimen/_22dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:text="@string/nav_settings"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
