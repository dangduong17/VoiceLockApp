<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:paddingHorizontal="@dimen/_24dp"
    android:paddingTop="@dimen/_48dp"
    android:paddingBottom="@dimen/_24dp">

    <TextView
        android:id="@+id/tvFaceAuthTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/face_auth_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFaceAuthSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:text="@string/face_auth_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFaceAuthTitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFacePreview"
        android:layout_width="@dimen/_240dp"
        android:layout_height="@dimen/_240dp"
        android:layout_marginTop="@dimen/_32dp"
        app:cardBackgroundColor="@color/bg_card_dark"
        app:cardCornerRadius="@dimen/_120dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFaceAuthSubtitle"
        app:strokeColor="@color/primary_blue"
        app:strokeWidth="@dimen/_3dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewFace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressFaceScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary_blue"
        app:indicatorSize="@dimen/_256dp"
        app:layout_constraintBottom_toBottomOf="@id/cardFacePreview"
        app:layout_constraintEnd_toEndOf="@id/cardFacePreview"
        app:layout_constraintStart_toStartOf="@id/cardFacePreview"
        app:layout_constraintTop_toTopOf="@id/cardFacePreview"
        app:trackThickness="@dimen/_3dp" />

    <TextView
        android:id="@+id/tvFaceAuthStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_28dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardFacePreview" />

    <TextView
        android:id="@+id/tvFaceAuthHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_14sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFaceAuthStatus" />

    <TextView
        android:id="@+id/tvFaceSimilarity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/_12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFaceAuthHint" />

    <TextView
        android:id="@+id/btnFaceAuthAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52dp"
        android:layout_marginBottom="@dimen/_8dp"
        android:background="@drawable/bg_blue_button"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/layoutFaceManage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="0dp" />

    <LinearLayout
        android:id="@+id/layoutFaceManage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnFaceReEnroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_12dp"
            android:text="@string/face_auth_re_enroll"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/_14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFaceDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16dp"
            android:padding="@dimen/_12dp"
            android:text="@string/face_auth_delete"
            android:textColor="@color/error_red"
            android:textSize="@dimen/_14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
