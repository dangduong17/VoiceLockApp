<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VoiceLock" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Every screen is drawn on bg_screen; the window paints it once, so layouts do not repeat it (overdraw). -->
        <item name="android:windowBackground">@color/bg_screen</item>
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.VoiceLock" parent="Base.Theme.VoiceLock" />

    <style name="PinKeypadKey">
        <item name="android:layout_width">@dimen/_72dp</item>
        <item name="android:layout_height">@dimen/_72dp</item>
        <item name="android:layout_margin">@dimen/_6dp</item>
        <item name="android:background">@drawable/bg_keypad_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        The app always draws light screens (bg_screen), but the theme is DayNight: in dark mode the
        Material text fields would pick light-on-dark colors. Forms apply this overlay to stay light.
    -->
    <style name="ThemeOverlay.VoiceLock.LightForm" parent="">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/text_muted</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>
</resources>
