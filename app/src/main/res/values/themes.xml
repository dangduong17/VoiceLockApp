<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Screens use the fixed VoiceLock palette (see colors.xml). -->
    <style name="Base.Theme.VoiceLock" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/vl_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/vl_info_bg</item>
        <item name="colorOnPrimaryContainer">@color/vl_ink</item>
        <item name="colorSecondaryContainer">@color/vl_info_bg</item>
        <item name="colorOnSecondaryContainer">@color/vl_primary</item>
        <item name="android:colorBackground">@color/vl_light_bg</item>
        <item name="colorSurface">@color/vl_card</item>
        <item name="colorOnSurface">@color/vl_ink</item>
    </style>

    <style name="Theme.VoiceLock" parent="Base.Theme.VoiceLock" />

    <!-- Text styles -->
    <style name="VoiceLock.Text.DialogTitle" parent="">
        <item name="android:textColor">@color/vl_ink</item>
        <item name="android:textSize">@dimen/_19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VoiceLock.Text.Body" parent="">
        <item name="android:textColor">@color/vl_ink_secondary</item>
        <item name="android:textSize">@dimen/_14sp</item>
        <item name="android:lineSpacingMultiplier">@dimen/line_spacing_body</item>
    </style>

    <!-- PinPadView keys (digits, backspace and the empty slot). -->
    <style name="VoiceLock.PinKey" parent="">
        <item name="android:layout_width">@dimen/_0dp</item>
        <item name="android:layout_height">@dimen/_68dp</item>
        <item name="android:layout_weight">@dimen/weight_fill</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/_26sp</item>
        <item name="android:fontFamily">@string/font_family_medium</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Sample progress chips on the voice enrollment screen. -->
    <style name="VoiceLock.Text.SampleChip" parent="">
        <item name="android:textSize">@dimen/_13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">@dimen/_4dp</item>
        <item name="android:paddingStart">@dimen/_14dp</item>
        <item name="android:paddingEnd">@dimen/_14dp</item>
        <item name="android:paddingTop">@dimen/_7dp</item>
        <item name="android:paddingBottom">@dimen/_7dp</item>
    </style>
</resources>
