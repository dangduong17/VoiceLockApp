<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.voicelock.feature.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pinLockFragment"
            app:destination="@id/pinLockFragment" />
        <action
            android:id="@+id/action_homeFragment_to_patternLockFragment"
            app:destination="@id/patternLockFragment" />
        <action
            android:id="@+id/action_homeFragment_to_appLockFragment"
            app:destination="@id/appLockFragment" />
        <action
            android:id="@+id/action_homeFragment_to_enrollmentFragment"
            app:destination="@id/enrollmentFragment" />
        <action
            android:id="@+id/action_homeFragment_to_twoStageAuthFragment"
            app:destination="@id/twoStageAuthFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.voicelock.feature.settings.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_pinLockFragment"
            app:destination="@id/pinLockFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_patternLockFragment"
            app:destination="@id/patternLockFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_appLockFragment"
            app:destination="@id/appLockFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_permissionsFragment"
            app:destination="@id/permissionsFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_enrollmentFragment"
            app:destination="@id/enrollmentFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_twoStageAuthFragment"
            app:destination="@id/twoStageAuthFragment" />
    </fragment>

    <fragment
        android:id="@+id/pinLockFragment"
        android:name="com.example.voicelock.feature.pinlock.PinLockFragment"
        android:label="PinLockFragment"
        tools:layout="@layout/fragment_pin_lock" />

    <fragment
        android:id="@+id/patternLockFragment"
        android:name="com.example.voicelock.feature.patternlock.PatternLockFragment"
        android:label="PatternLockFragment"
        tools:layout="@layout/fragment_pattern_lock" />

    <fragment
        android:id="@+id/appLockFragment"
        android:name="com.example.voicelock.feature.applock.AppLockFragment"
        android:label="AppLockFragment"
        tools:layout="@layout/fragment_app_lock">
        <action
            android:id="@+id/action_appLockFragment_to_permissionsFragment"
            app:destination="@id/permissionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/permissionsFragment"
        android:name="com.example.voicelock.feature.permissions.PermissionsFragment"
        android:label="PermissionsFragment"
        tools:layout="@layout/fragment_permissions" />

    <fragment
        android:id="@+id/enrollmentFragment"
        android:name="com.example.voicelock.feature.voice.enrollment.EnrollmentFragment"
        android:label="EnrollmentFragment"
        tools:layout="@layout/fragment_enrollment" />

    <fragment
        android:id="@+id/twoStageAuthFragment"
        android:name="com.example.voicelock.feature.voice.auth.TwoStageAuthFragment"
        android:label="TwoStageAuthFragment"
        tools:layout="@layout/fragment_two_stage_auth">
        <action
            android:id="@+id/action_twoStageAuthFragment_to_enrollmentFragment"
            app:destination="@id/enrollmentFragment" />
    </fragment>

</navigation>
